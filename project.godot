; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Stonkport"
config/description="Client-side trade journal rendered entirely with Godot UI."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.0509804, 0.0666667, 0.0901961, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"
config/features/Packed/disable_splash_screen=true

[autoload]

MarketSimulator="*res://scripts/autoload/market_simulator.gd"
TradeManager="*res://scripts/autoload/trade_manager.gd"
YFinance="*res://scripts/net/yfinance_client.gd"
TrayLauncher="*res://scripts/tray/tray_launcher.gd"

[display]

window/stretch/aspect="ignore"

[gui]

theme/custom="res://theme/theme.tres"

[internationalization]

rendering/text_driver="Fallback"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.0509804, 0.0666667, 0.0901961, 1)
